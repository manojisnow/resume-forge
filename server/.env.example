# Copy to server/.env. Never add real credentials to this example.
# Select: anthropic | ollama | llamacpp
AI_PROVIDER=ollama
PORT=3001

# Anthropic (cloud): resume text is sent to Anthropic when selected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# llama.cpp (local)
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local-model
LLAMACPP_API_KEY=

# Container runner configuration; copy this file to .env next to compose.yml.
# Native npm development still uses server/.env instead.
APP_PORT=8080
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Pin a published release here for reproducible upgrades.
RESUMEFORGE_IMAGE=ghcr.io/manojisnow/resume-forge:latest
